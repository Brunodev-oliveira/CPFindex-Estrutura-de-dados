<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12">

<center>
    <TabPane tabClosingPolicy="UNAVAILABLE">
        <tabs>

            <Tab text="⚙  Operações">
                <content>
                    <fx:include source="OperationView.fxml" />
                </content>
            </Tab>

            <Tab text="  Demonstração BST">
                <content>
                    <fx:include source="DemoView.fxml" />
                </content>
            </Tab>
            <Tab text=" Comparação">
                <content>
                    <fx:include source="CompareView.fxml" />
                </content>
            </Tab>

        </tabs>
    </TabPane>
</center>
   <top>
       <ToolBar prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER" style="-fx-padding: 0; -fx-spacing: 0;">
           <items>
            <ImageView fitHeight="150.0" fitWidth="200.0"  pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/logo.png" />
               </image>
            </ImageView>
         </items>
      </ToolBar>
   </top>

</BorderPane>
